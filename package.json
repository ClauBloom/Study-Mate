{
  "name": "@yunmiao/studymate",
  "version": "0.1.3",
  "description": "Install the StudyMate learning preset, skills and lesson engine for DeepSeek Harness.",
  "bin": {
    "studymate": "bin/studymate.mjs"
  },
  "exports": {
    ".": "./bin/dsh-plugin.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "cordis.patch.yml",
    "bin/*.mjs",
    ".dsh/skills/**",
    "preset/learning/**",
    "scripts/*.py",
    "schemas/*.json",
    "templates/**",
    "docs/*.md",
    "docs/images/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test:installer": "node --test scripts/tests/test_installer.mjs scripts/tests/test_bundle.mjs",
    "test:dsh": "node --test scripts/tests/test_dsh_runtime.mjs",
    "test:dsh-cli": "node --test scripts/tests/test_dsh_plugin_cli.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "author": "Cattofu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miaotofu01/Study-Mate.git"
  },
  "homepage": "https://github.com/Miaotofu01/Study-Mate#readme",
  "bugs": {
    "url": "https://github.com/Miaotofu01/Study-Mate/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "studymate",
    "learning",
    "education"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
