{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Progress",
  "type": "object",
  "required": ["updated_at", "nodes", "misconceptions", "project"],
  "properties": {
    "updated_at": { "type": "string", "format": "date-time" },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "mastery"],
        "properties": {
          "status": { "enum": ["未开始", "学习中", "初步理解", "能独立应用", "需要复习", "已通过项目验证"] },
          "mastery": { "type": "number", "minimum": 0, "maximum": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "question", "misunderstanding", "answer_summary"],
        "properties": {
          "topic": { "type": "string" },
          "question": { "type": "string" },
          "misunderstanding": { "type": "string" },
          "answer_summary": { "type": "string" },
          "follow_up": { "type": "string" },
          "importance": { "enum": ["low", "medium", "high"] }
        }
      }
    },
    "project": {
      "type": "object",
      "required": ["current", "milestones"],
      "properties": {
        "current": { "type": "string" },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "description": "项目路标。挂在这些路标上的节点才是实操课（配 lab）；其余节点是概念课，题目止于 L1-L3。",
          "items": {
            "type": "object",
            "required": ["text", "nodes", "done"],
            "properties": {
              "text": { "type": "string" },
              "nodes": {
                "type": "array",
                "minItems": 1,
                "description": "实现这个路标的节点 id（curriculum.yaml 的 nodes[].id）",
                "items": { "type": "string" }
              },
              "done": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
