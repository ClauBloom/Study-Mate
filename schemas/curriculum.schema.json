{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Curriculum",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "objective", "prerequisites", "status", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$" },
          "title": { "type": "string" },
          "kind": {
            "enum": ["概念", "实操", "实验"],
            "description": "节点类型。概念=轻量跟做+概念题（不配 lab，题目止于 L3）；实操=普通课带自己的小 lab；实验=里程碑验收课（插在大纲里与普通课同级，prerequisites 列出它验收的节点，产出实验说明页 + 实操任务，通过后被验收节点置「已通过项目验证」）。"
          },
          "objective": { "type": "string" },
          "problem": { "type": "string" },
          "prerequisites": { "type": "array", "items": { "type": "string" } },
          "concepts": { "type": "array", "items": { "type": "string" } },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "type"],
              "properties": {
                "title": { "type": "string" },
                "url": { "type": "string" },
                "type": { "enum": ["official-doc", "book", "article", "video"] }
              }
            }
          },
          "practice": { "type": "string" },
          "pitfalls": { "type": "array", "items": { "type": "string" } },
          "realworld": { "type": "string" },
          "验收点": {
            "type": "array",
            "items": { "type": "string" },
            "description": "过关标准：学完凭什么算做到了（可观察、可核对）。原字段名 evidence，2026-xx 题目系统重构时正名。"
          },
          "status": { "enum": ["未开始", "学习中", "初步理解", "能独立应用", "需要复习", "已通过项目验证"] },
          "mastery": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "reason"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
